#!/usr/bin/env bash
# Configures Nginx with a clean 301 redirect

# Install nginx
apt-get update -y
apt-get install -y nginx

# 1. Remove any previous attempts to avoid duplicates
sed -i '/redirect_me/d' /etc/nginx/sites-available/default

# 2. Insert the rewrite rule specifically after the 'server_name _;' line
# This ensures it is INSIDE the server block
target="https://www.youtube.com/watch?v=QH2-TGUlwu4"
sed -i "/server_name _;/a \\\trewrite ^/redirect_me/?$ $target permanent;" /etc/nginx/sites-available/default

# 3. Verify syntax and restart
nginx -t && service nginx restart
